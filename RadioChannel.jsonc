{
  "name": "RadioChannel",
  "type": "object",
  "properties": {
    "server_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "color": {
      "type": "string",
      "default": "#CE0000"
    },
    "description": {
      "type": "string"
    },
    "allowed_dept_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "e.g. ['police','dispatch'] \u2014 empty = all"
    },
    "active_users": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of user emails currently on this channel"
    }
  },
  "required": [
    "server_id",
    "name"
  ]
}